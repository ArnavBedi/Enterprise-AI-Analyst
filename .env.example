# Required: create a key in Google AI Studio.
GOOGLE_API_KEY=replace_me
DATABASE_URL=postgresql+psycopg2://analyst_reader:analyst_reader_password@localhost:5433/analytics

# Optional named profiles. Each entry maps a label to an environment variable.
# DATABASE_PROFILES=Local PostgreSQL:DATABASE_URL,MySQL Warehouse:MYSQL_DATABASE_URL
# MYSQL_DATABASE_URL=mysql+pymysql://readonly_user:password@localhost:3306/analytics

# Optional application and database security controls.
# APP_ACCESS_PASSWORD=replace_with_a_strong_password
ALLOWED_DATABASE_HOSTS=localhost,127.0.0.1
QUERY_TIMEOUT_MS=15000
MAX_POSTGRES_QUERY_COST=100000
MAX_SCHEMA_OBJECTS=100
MAX_COLUMNS_PER_TABLE=100
